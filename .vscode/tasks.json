{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Web: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "API: bootRun",
      "type": "shell",
      "command": "python3 scripts/run-local.py api",
      "problemMatcher": []
    },
    {
      "label": "AI: API",
      "type": "shell",
      "command": "python3 scripts/run-local.py ai",
      "problemMatcher": []
    },
    {
      "label": "AI: Worker",
      "type": "shell",
      "command": "python3 scripts/run-local.py worker",
      "problemMatcher": []
    },
    {
      "label": "Compose: baseline",
      "type": "shell",
      "command": "docker compose up --build",
      "problemMatcher": []
    },
    {
      "label": "Checks",
      "type": "shell",
      "command": "make test",
      "problemMatcher": []
    },
    {
      "label": "Prepare: local env",
      "type": "shell",
      "command": "python3 scripts/run-local.py prepare",
      "problemMatcher": []
    },
    {
      "label": "Compose: dependencies",
      "type": "shell",
      "command": "docker compose -f compose.yaml -f compose.dev.yaml up -d postgres ai",
      "problemMatcher": []
    }
  ]
}
