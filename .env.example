# Copy to .env. Replace all CHANGE_ME values before local startup. Never commit .env.
POSTGRES_DB=staffing
POSTGRES_USER=staffing
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
APP_DEMO_ACCOUNT_PASSWORD=CHANGE_ME_LOCAL_ACCOUNT_PASSWORD
APP_DEMO_MANAGER_PASSWORD=CHANGE_ME_LOCAL_MANAGER_PASSWORD
AI_MODE=baseline
WEB_PORT=8080
# Optional local models: place a compatible GGUF and embedding files in ./models.
INSTALL_LOCAL_MODELS=false
MODEL_IMAGE=ghcr.io/ggml-org/llama.cpp:server
MODEL_FILE=qwen.gguf
EMBEDDING_MODEL_PATH=/models/embedding
LOCAL_FILES_ONLY=true
